# Lista de plugins (separados por un espacio)
# Nota: WooCommerce debe estar aquí para que se instale
WP_PLUGINS=woocommerce astra-sites woo-variation-swatches libro-de-reclamaciones-y-quejas ubigeo-peru woocommerce-mercadopago all-in-one-wp-migration

# Tema principal a instalar y activar
WP_THEME=astra

# Datos de tu sitio WordPress
SITE_URL=http://localhost:8080
SITE_TITLE="La Pañalera"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin123
WP_ADMIN_EMAIL=admin@tudominio.com

# Credenciales de la Base de Datos
DB_USER=wp_user
DB_PASSWORD=wp_password
DB_NAME=wordpress_db